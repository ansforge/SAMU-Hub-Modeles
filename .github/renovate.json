{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["* * 24-30 * 3"],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "14 days",
  "automerge": false,
  "registryAliases": {
    "dhi.io": "dhi.io"
  },
  "hostRules": [
    {
      "matchHost": "dhi.io",
      "hostType": "docker",
      "username": "{{ secrets.DHI_USERNAME }}",
      "password": "{{ secrets.DHI_PASSWORD }}"
    }
  ],
  "includePaths": [
    "converter/**",
    ".github/workflows/**",
    "build.gradle"
  ],
  "packageRules": [
    {
      "description": "Mises à jour des GitHub Actions",
      "matchManagers": ["github-actions"],
      "schedule": ["* * 21-30 * 1"],
      "groupName": "github-actions",
      "separateMajorMinor": false
    },
    {
      "description": "Mises à jour des dépendances - Converter",
      "matchFileNames": ["converter/**"],
      "schedule": ["* * 21-30 * 1"],
      "groupName": "converter dependencies"
    },
    {
      "description": "Mises à jour des dépendances - lib models",
      "matchFileNames": ["build.gradle"],
      "schedule": ["* * 1-10 * 1"],
      "groupName": "models dependencies"
    }
  ],
  "vulnerabilityAlerts": {
    "groupName": "security updates"
  }
}
